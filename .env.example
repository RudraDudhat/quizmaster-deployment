# ============================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env      (PowerShell:  Copy-Item .env.example .env)
# `.env` is git-ignored — never commit real secrets.
# ============================================================

# ---- Postgres (single instance, one DB per service) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ---- JWT (auth-service signs, api-gateway verifies — MUST match) ----
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=quizmaster
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- CORS (browser origins allowed through the gateway) ----
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ---- Kafka ----
KAFKA_ENABLED=true

# ---- Google OAuth (non-empty required or auth-service fails to start) ----
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_SCOPES=email,profile

# ---- Mail (placeholders — set real SMTP to actually send email) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=changeme@example.com
MAIL_PASSWORD=changeme
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=false

# ---- Per-app JVM heap cap ----
JAVA_OPTS=-Xmx384m -XX:+UseSerialGC
